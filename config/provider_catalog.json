      "connection_rpm": 10,
      "source_detection": "provider_defined",
      "source_languages": [
        "auto",
        "zh",
        "en",
        "fr",
        "es",
        "it",
        "ja",
        "ko",
        "de"
      ],
      "target_languages": [
        "zh",
        "en",
        "fr",
        "es",
        "it",
        "ja",
        "ko",
        "de"
      ],
      "output_modalities": [
        "text"
      ],
